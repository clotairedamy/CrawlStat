# Copy to .env for local development. In production these are Vercel
# environment variables; none of them is ever sent to the browser.

# Ed25519 private key that signs entitlement tokens, as a PKCS#8 PEM.
# Generate one with:
#   openssl genpkey -algorithm ed25519 -out signing.pem
#   openssl pkey -in signing.pem -pubout -outform DER | tail -c 32 | xxd -p -c 32
# The second command prints the public key to embed in the app
# (engine/src/license.rs, SIGNING_PUBLIC_KEY_HEX).
NUXT_LICENSE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Which merchant of record is in use: lemonsqueezy | polar | paddle
NUXT_LICENSE_PROVIDER=lemonsqueezy

# The provider's API credentials.
NUXT_PROVIDER_API_KEY=
NUXT_PROVIDER_STORE_ID=

# Shared secret for verifying incoming webhook signatures.
NUXT_WEBHOOK_SECRET=
